# IRDoc Environment Configuration
# Copy this to docker/.env and fill in values before running.
#   cp .env.example docker/.env
# Never commit docker/.env to source control.

# ─── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://irp:changeme_strong_password@db/irp

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@redis:6379/0

# ─── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage
# Cloud storage (premium) is configured via the admin UI, not here.

# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=IRDoc
BASE_URL=http://localhost:3000
ALLOW_REGISTRATION=true   # set to false in production to require invites

# ─── License ───────────────────────────────────────────────────────────────────
# Leave empty for core (AGPL) features only.
# Set to your commercial key to unlock premium features.
LICENSE_KEY=

# ─── Inbound Webhook ───────────────────────────────────────────────────────────
WEBHOOK_RATE_LIMIT=20              # requests per minute per API key
WEBHOOK_MAX_PAYLOAD_BYTES=65536    # 64 KB max

# ─── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=console              # console | smtp | resend

# ─── AI (Phase 3) ──────────────────────────────────────────────────────────────
AI_BACKEND=anthropic               # anthropic | openai | ollama
AI_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://ollama:11434

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Defaults to BASE_URL. Override for custom domain setups.
# CORS_ORIGINS=http://localhost:3000,https://irdoc.example.com

# ─── Demo environment only ───────────────────────────────────────────────────
# Read exclusively by backend/seed_demo.py (never by the app itself, and never
# run automatically — see that script's docstring). Leave all of these unset
# on a real install. DEMO_PASSWORD is the shared fallback for all 4 demo
# accounts; the per-role vars override it individually if you want each demo
# account to have its own password instead.
# DEMO_PASSWORD=
# DEMO_ADMIN_PASSWORD=
# DEMO_SENIOR_ANALYST_PASSWORD=
# DEMO_ANALYST_PASSWORD=
# DEMO_VIEWER_PASSWORD=
